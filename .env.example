# Copiá este archivo a `.env` y completá la key.
# Generala gratis en https://web3forms.com con el email de destino.
VITE_WEB3FORMS_KEY=tu_access_key_aca

# Supabase (Project Settings > API Keys)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
# Publishable key (sb_publishable_...). Es pública, va en el bundle.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Panel /paginas-admin (solo servidor; NUNCA con prefijo VITE_)
ADMIN_USER=usuario
ADMIN_PASSWORD=una_clave_larga_y_unica
# Generar con: openssl rand -hex 32
ADMIN_SESSION_SECRET=
# Supabase secret key (sb_secret_...). Solo servidor.
SUPABASE_SECRET_KEY=
