{
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/noticias/:slug", "destination": "/api/news-meta?slug=:slug" },
    { "source": "/paginas-admin", "destination": "/app-shell.html" },
    { "source": "/paginas-admin/:path*", "destination": "/app-shell.html" }
  ],
  "headers": [
    {
      "source": "/paginas-admin(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
